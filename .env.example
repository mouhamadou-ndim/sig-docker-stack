# Copier ce fichier en .env, puis renseigner chaque mot de passe.
# Générer une valeur : openssl rand -hex 24
# Utiliser uniquement des lettres et des chiffres (pas de guillemet, d'antislash ni de $).

POSTGRES_DB=sig
POSTGRES_USER=sig_admin
POSTGRES_PASSWORD=

# Rôles applicatifs créés à l'initialisation de la base
ETL_DB_PASSWORD=
GEOSERVER_DB_PASSWORD=

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=

# Exposition de Nginx sur l'hôte (127.0.0.1 = accessible uniquement en local)
NGINX_BIND=127.0.0.1
NGINX_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Départements de métropole chargés par l'ETL, séparés par des virgules
ETL_DEPARTEMENTS=91
